<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Order - {{orderNumber}}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
      color: #1a1a1a;
      margin: 0;
      padding: 40px;
      font-size: 11px;
    }

    .header {
      text-align: center;
      margin-bottom: 20px;
      border-bottom: 2px solid #000;
      padding-bottom: 10px;
    }

    .header h1 {
      margin: 0 0 5px 0;
      font-size: 24px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .meta-grid {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .meta-box {
      border: 1px solid #ccc;
      padding: 10px;
      width: 48%;
      border-radius: 4px;
    }

    .meta-row {
      display: flex;
      margin-bottom: 5px;
    }

    .meta-label {
      font-weight: 600;
      width: 100px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
    }

    th, td {
      border: 1px solid #000;
      padding: 8px 6px;
      text-align: center;
    }

    th {
      background-color: #f4f4f4;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 10px;
    }

    .text-left { text-align: left; }
    .text-right { text-align: right; }

    .summary-box {
      width: 300px;
      float: right;
      border: 1px solid #000;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 12px;
      border-bottom: 1px solid #ccc;
    }
    .summary-row:last-child {
      border-bottom: none;
      font-weight: bold;
      font-size: 14px;
      background-color: #f4f4f4;
    }

    .clearfix::after {
      content: "";
      clear: both;
      display: table;
    }

    /* Prevent page breaks inside rows */
    tr {
      page-break-inside: avoid;
    }
  </style>
</head>
<body>

  <div class="header">
    <h1>Order Form</h1>
    <div>Generated via OrderFlow</div>
  </div>

  <div class="meta-grid">
    <div class="meta-box">
      <strong>BUYER:</strong>
      <div class="meta-row"><div class="meta-label">Name:</div><div>{{companyTemplate.buyerName}}</div></div>
      <div class="meta-row"><div class="meta-label">City:</div><div>{{companyTemplate.buyerCity}}</div></div>
      <div class="meta-row"><div class="meta-label">Mobile:</div><div>{{companyTemplate.buyerMobile}}</div></div>
      <div class="meta-row"><div class="meta-label">Ref:</div><div>{{companyTemplate.buyerRef}}</div></div>
      <div class="meta-row"><div class="meta-label">Agency:</div><div>{{companyTemplate.buyerAgency}}</div></div>
    </div>
    <div class="meta-box">
      <strong>SELLER:</strong>
      <div class="meta-row"><div class="meta-label">Name:</div><div>{{companyTemplate.sellerName}}</div></div>
      <div class="meta-row"><div class="meta-label">GSTIN:</div><div>{{companyTemplate.sellerGstin}}</div></div>
      <div class="meta-row"><div class="meta-label">Phone:</div><div>{{companyTemplate.sellerPhone}}</div></div>
    </div>
  </div>
  
  <div style="text-align: right; margin-bottom: 10px;">
    <strong>Order No:</strong> {{orderNumber}} &nbsp;|&nbsp; 
    <strong>Date:</strong> {{orderDateStr}}
  </div>

  <table>
    <thead>
      <tr>
        <th>S.No</th>
        <th>Image</th>
        <th>Code</th>
        <th>Qty</th>
        <th>Net Price</th>
        <th>Sizes (#)</th>
        <th>Sizes</th>
        <th class="text-right">Line Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each groupedProducts}}
      <tr>
        <td colspan="8" style="text-align: left; background-color: #e2e8f0; font-weight: bold;">Category: {{this.category}}</td>
      </tr>
      {{#each this.products}}
      <tr>
        <td>{{increment @index}}</td>
        <td style="width: 50px; height: 50px; background-color: #fcfcfc;">
          {{#if this.imageUrl}}
            <img src="{{this.imageUrl}}" style="max-width: 50px; max-height: 50px;" />
          {{/if}}
        </td>
        <td>{{this.productCode}}</td>
        <td>{{this.quantity}}</td>
        <td>₹{{this.netPrice}}</td>
        <td>{{this.sizeCount}}</td>
        <td>{{this.sizesDisplay}}</td>
        <td class="text-right">₹{{this.lineTotal}}</td>
      </tr>
      {{/each}}
      {{/each}}
    </tbody>
  </table>

  <div class="clearfix">
    <div class="summary-box">
      <div class="summary-row">
        <span>Total Quantity:</span>
        <span>{{totalQty}} Units</span>
      </div>
      <div class="summary-row">
        <span>Advance Payment:</span>
        <span>₹{{advancePayment}}</span>
      </div>
      <div class="summary-row">
        <span>Grand Total:</span>
        <span>₹{{grandTotal}}</span>
      </div>
    </div>
  </div>

</body>
</html>
